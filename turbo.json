{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc", ".bun-version"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build:ios": {
      "env": [
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/*.podspec",
        "$TURBO_ROOT$/react-native.config.js",
        "$TURBO_ROOT$/ios/**",
        "$TURBO_ROOT$/common/**",
        "$TURBO_ROOT$/src/**",
        "package.json",
        "app.json",
        "app/**",
        "src/**",
        "plugins/**",
        "assets/**",
        "*.js"
      ],
      "outputs": []
    }
  }
}
